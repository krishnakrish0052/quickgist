# ─── Public site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=QuickGist

# ─── Admin console ─────────────────────────────────────────────
# Required in production. In development the default `dev-admin-key` is allowed.
ADMIN_API_KEY=dev-admin-key

# ─── Pipeline defaults ─────────────────────────────────────────
PIPELINE_DRY_RUN=true
PIPELINE_AUTO_PUBLISH=false
AUTO_PUBLISH_QUALITY_THRESHOLD=86
AUTO_PUBLISH_CONFIDENCE_THRESHOLD=0.50
REVIEW_CONFIDENCE_THRESHOLD=0.30
MIN_SOURCES_FOR_PUBLISH=1
HIGH_RISK_CATEGORIES=legal,conflict,elections

# ─── Storage (optional for dev) ────────────────────────────────
# Leave STORAGE_DRIVER blank or set to "memory" to run with no external services.
# Set to "postgres" + provide DATABASE_URL to persist across restarts.
#
# Native install hints (no Docker required):
#   Ubuntu/Debian: sudo apt install postgresql redis-server
#   macOS:         brew install postgresql@16 redis && brew services start postgresql@16 redis
#   Arch/WSL:      sudo pacman -S postgresql redis
#
STORAGE_DRIVER=memory
DATABASE_URL=postgres://quickgist:quickgist@localhost:5432/quickgist

# ─── Job queue (optional) ──────────────────────────────────────
# Leave REDIS_URL blank to run jobs inline (no BullMQ). Set it to enable workers.
QUEUE_DRIVER=inline
REDIS_URL=

# ─── AI providers (optional — local deterministic mode without keys) ──
# AI_PROVIDER: "auto" (first available) | "deepseek" | "groq" | "openai" | "gemini"
AI_PROVIDER=auto
# AI_MODEL: override the default model (optional)
#   DeepSeek defaults: deepseek-chat (OpenAI-compatible, https://api.deepseek.com/v1)
#   Groq defaults:     llama-3.3-70b-versatile
#   OpenAI defaults:   gpt-4o-mini
#   Gemini defaults:   gemini-2.0-flash
AI_MODEL=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
MODEL_DAILY_TOKEN_BUDGET=250000

# ─── Image search — add any ONE key for real, story-relevant article images ──
# Pexels:   free signup → https://www.pexels.com/api/           (200 req/hr)
# Pixabay:  free signup → https://pixabay.com/api/docs/         (unlimited)
# Unsplash: free signup → https://unsplash.com/developers       (50 req/hr)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ─── Data sources (optional) ───────────────────────────────────
NEWSAPI_KEY=
GNEWS_KEY=
THENEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ─── Media (optional) ──────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quickgist-media
R2_PUBLIC_BASE_URL=

# ─── Distribution channels (optional) ──────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
LINKEDIN_ACCESS_TOKEN=
X_BEARER_TOKEN=
INSTAGRAM_GRAPH_TOKEN=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# ─── Google AdSense ─────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_ADSENSE_SLOT=
